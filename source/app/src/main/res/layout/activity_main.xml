<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboardRoot"
    android:orientation="vertical"
    android:fitsSystemWindows="false"
    android:background="#F5F7F8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView android:id="@+id/dashboardScroll" android:fillViewport="true" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:clipChildren="false" android:clipToPadding="false" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="30dp" android:layout_width="match_parent" android:layout_height="wrap_content">

<FrameLayout
        android:id="@+id/mainHeader"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="18dp" android:paddingEnd="12dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        android:layout_width="match_parent" android:layout_height="58dp">
        <com.localqbank.library.RovexHeaderBirdView android:id="@+id/headerBird" android:layout_width="match_parent" android:layout_height="112dp" android:layout_gravity="top" android:elevation="6dp" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
        <com.localqbank.library.RovexHeaderWordmarkView android:id="@+id/appLogoText" android:contentDescription="Rovex" android:layout_width="150dp" android:layout_height="44dp" android:layout_gravity="start|center_vertical" android:padding="0dp" />
        <ImageButton android:id="@+id/themeButton" android:contentDescription="Settings and app menu" android:src="@drawable/ic_settings" android:background="@android:color/transparent" android:scaleType="center" android:padding="8dp" android:minWidth="0dp" android:minHeight="0dp" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="end|center_vertical" />
    </FrameLayout>

            <LinearLayout android:id="@+id/homeSearchCard" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="10dp" android:clickable="true" android:focusable="true" android:layout_width="match_parent" android:layout_height="54dp">
                <ImageView android:id="@+id/homeSearchIcon" android:src="@drawable/ic_search" android:contentDescription="Search" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="9dp" />
                <TextView android:id="@+id/homeSearchText" android:text="Search questions, QBanks or topics" android:textSize="15sp" android:textColor="#66727D" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <TextView android:id="@+id/homeSearchShortcut" android:text="⌘ K" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:textColor="#87919A" android:layout_width="46dp" android:layout_height="28dp" />
            </LinearLayout>

            <com.localqbank.library.RovexFlowBorderLayout android:id="@+id/renCard" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:layout_width="match_parent" android:layout_height="58dp">
                <com.localqbank.library.RovexJumpTextView android:text="Dr. Frankenstein" android:textSize="17sp" android:textStyle="bold" android:textColor="#17212B" android:gravity="center_vertical|start" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                <TextView android:text="Ask • Plan • Learn  ›" android:textSize="12sp" android:textColor="#66727D" android:gravity="center" android:layout_width="wrap_content" android:layout_height="40dp"/>
            </com.localqbank.library.RovexFlowBorderLayout>

            <LinearLayout android:id="@+id/dashboardHero" android:orientation="vertical" android:padding="20dp" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                        <com.localqbank.library.RovexWaveTextView android:id="@+id/dashboardGreeting" android:text="Good morning" android:textSize="27sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/dashboardFocus" android:text="Your adaptive study plan is ready." android:textSize="13sp" android:textColor="#DCEAF2" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView android:id="@+id/dashboardAccuracyHero" android:text="0%\naccuracy" android:textSize="13sp" android:textStyle="bold" android:gravity="center" android:textColor="#FFFFFF" android:layout_width="74dp" android:layout_height="74dp" />
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><TextView android:id="@+id/heroDue" android:text="0" android:textSize="23sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="due today" android:textSize="11sp" android:textColor="#DCEAF2" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
                    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><TextView android:id="@+id/heroSolved" android:text="0" android:textSize="23sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="solved today" android:textSize="11sp" android:textColor="#DCEAF2" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
                    <TextView android:id="@+id/heroAction" android:text="CONTINUE  ›" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:textColor="#17384A" android:background="#FFFFFF" android:layout_width="108dp" android:layout_height="40dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/quickActions" android:orientation="horizontal" android:weightSum="3" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.localqbank.library.RovexColorFlowTextView android:id="@+id/quickRevision" android:text="Today’s Revision" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:textColor="#17384A" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="4dp" />
                <com.localqbank.library.RovexColorFlowTextView android:id="@+id/quickSubject" android:text="Subject Focus" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:textColor="#17384A" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
                <com.localqbank.library.RovexColorFlowTextView android:id="@+id/quickWrong" android:text="Wrong Qs" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:textColor="#17384A" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/analyticsCard" android:orientation="vertical" android:padding="17dp" android:clickable="true" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><com.localqbank.library.RovexColorFlowTextView android:id="@+id/analyticsTitle" android:text="Performance" android:textSize="19sp" android:textStyle="bold" android:textColor="#17212B" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/analyticsSub" android:text="Your recent solving signal" android:textSize="12sp" android:textColor="#66727D" android:layout_marginTop="3dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
                    <TextView android:id="@+id/analyticsCardAction" android:contentDescription="Open performance details" android:text="DETAILS  ›" android:textSize="11sp" android:textStyle="bold" android:textColor="#245E78" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_width="wrap_content" android:layout_height="48dp" />
                </LinearLayout>
                <ProgressBar android:id="@+id/analyticsProgress" style="?android:attr/progressBarStyleHorizontal" android:max="100" android:progress="0" android:layout_marginTop="15dp" android:layout_width="match_parent" android:layout_height="7dp" />
                <LinearLayout android:orientation="horizontal" android:layout_marginTop="13dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><TextView android:id="@+id/analyticsAccuracy" android:text="0%" android:textSize="22sp" android:textStyle="bold" android:textColor="#17212B" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="accuracy" android:textSize="11sp" android:textColor="#78838D" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
                    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><TextView android:id="@+id/analyticsAttempted" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="#17212B" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="attempted" android:textSize="11sp" android:textColor="#78838D" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
                    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><TextView android:id="@+id/analyticsDue" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="#17212B" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="due" android:textSize="11sp" android:textColor="#78838D" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:orientation="horizontal" android:weightSum="2" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/todaySolvedCard" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:clickable="true" android:layout_width="0dp" android:layout_height="104dp" android:layout_weight="1" android:layout_marginEnd="5dp"><TextView android:text="TODAY" android:textSize="11sp" android:textStyle="bold" android:textColor="#55756F" android:layout_width="match_parent" android:layout_height="wrap_content"/><com.localqbank.library.RovexColorFlowTextView android:id="@+id/todaySolvedLabel" android:text="Solved" android:textSize="17sp" android:textStyle="bold" android:textColor="#17212B" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/todaySolvedCount" android:text="0" android:textSize="32sp" android:textStyle="bold" android:textColor="#1B665A" android:layout_marginTop="1dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
                <LinearLayout android:id="@+id/studyMenuCard" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:clickable="true" android:layout_width="0dp" android:layout_height="104dp" android:layout_weight="1" android:layout_marginStart="5dp"><TextView android:visibility="gone" android:text="STUDY" android:textSize="11sp" android:textStyle="bold" android:textColor="#5E5A78" android:layout_width="match_parent" android:layout_height="wrap_content"/><com.localqbank.library.RovexColorFlowTextView android:id="@+id/studyMenuTitle" android:text="Study tools" android:textSize="20sp" android:textStyle="bold" android:textColor="#17212B" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/studyMenuSub" android:visibility="gone" android:text="Revision • PYQ • tests" android:textSize="12sp" android:textColor="#66727D" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/flashcardCard" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:layout_marginTop="12dp" android:clickable="true" android:layout_width="match_parent" android:layout_height="72dp"><LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><com.localqbank.library.RovexColorFlowTextView android:id="@+id/flashcardTitle" android:text="Flashcards" android:textSize="17sp" android:textStyle="bold" android:textColor="#17212B" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="Spaced repetition and imported decks" android:textSize="12sp" android:textColor="#66727D" android:layout_marginTop="3dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout><TextView android:text="›" android:textSize="28sp" android:textColor="#7A858E" android:gravity="center" android:layout_width="30dp" android:layout_height="50dp"/></LinearLayout>

            <com.localqbank.library.RovexWaveTextView android:text="Collections" android:textSize="20sp" android:textStyle="bold" android:textColor="#17212B" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:orientation="horizontal" android:weightSum="2" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/importantButton" android:text="★ Important\n0" android:textAllCaps="false" android:textColor="#25364A" android:textSize="13sp" android:gravity="center" android:layout_marginEnd="5dp" android:layout_width="0dp" android:layout_height="68dp" android:layout_weight="1"/><Button android:id="@+id/reviseButton" android:text="↻ Revise\n0" android:textAllCaps="false" android:textColor="#25364A" android:textSize="13sp" android:gravity="center" android:layout_marginStart="5dp" android:layout_width="0dp" android:layout_height="68dp" android:layout_weight="1"/></LinearLayout>
            <LinearLayout android:orientation="horizontal" android:weightSum="2" android:layout_marginTop="9dp" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/doubtButton" android:text="❔ Doubt\n0" android:textAllCaps="false" android:textColor="#25364A" android:textSize="13sp" android:gravity="center" android:layout_marginEnd="5dp" android:layout_width="0dp" android:layout_height="68dp" android:layout_weight="1"/><Button android:id="@+id/favoriteButton" android:text="♥ Favourite\n0" android:textAllCaps="false" android:textColor="#25364A" android:textSize="13sp" android:gravity="center" android:layout_marginStart="5dp" android:layout_width="0dp" android:layout_height="68dp" android:layout_weight="1"/></LinearLayout>

            <LinearLayout android:id="@+id/qbankSection" android:orientation="vertical" android:padding="15dp" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"><LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content"><com.localqbank.library.RovexWaveTextView android:text="Your QBanks" android:textSize="20sp" android:textStyle="bold" android:textColor="#17212B" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/><Button android:id="@+id/addButton" android:text="＋ Add QBank" android:textSize="12sp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_width="wrap_content" android:layout_height="40dp"/></LinearLayout><TextView android:id="@+id/stats" android:text="No QBanks added yet" android:textSize="12sp" android:textColor="#66727D" android:layout_marginTop="3dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><androidx.recyclerview.widget.RecyclerView android:id="@+id/libraryList" android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="8dp" android:clipToPadding="false" android:paddingBottom="10dp" android:scrollbars="vertical" android:overScrollMode="ifContentScrolls" android:nestedScrollingEnabled="true" /></LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
